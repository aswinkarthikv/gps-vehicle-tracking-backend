PROJECT_NAME=GPS Vehicle Tracking System
VERSION=1.0.0
API_V1_STR=/api
SECRET_KEY=super-secret-jwt-key-for-assessment-evaluation-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (defaults to SQLite if PostgreSQL is not available)
DATABASE_URL=sqlite:///./vehicle_tracker.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://tracker_user:tracker_pass@db:5432/vehicle_tracker_db

# MQTT Broker Settings
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=vehicle/telemetry
MQTT_CLIENT_ID=fastapi_gps_backend
MQTT_ENABLED=true
